# Copy to .env and fill in values — never commit .env

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:2006@localhost:5432/appdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Frontend
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000

# Session persistence
SESSION_DIR=.sessions
SESSION_CHECKPOINT_INTERVAL_SECONDS=300
